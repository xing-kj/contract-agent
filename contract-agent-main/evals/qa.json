{
  "_说明": "追问评测，合同是 samples/zufang-03.pdf（84 条的长租公寓合同）。expect 是能回答这个问题的条款，引用其中任意一条并核对通过就算答对；expect 为空表示合同里确实没写，回答要以“合同里没写”开头。直白 = 问题里有条款里的词；换说法 = 用租客自己的话问，和条款用词基本不重合；没写 = 合同里确实没有。",
  "contract": "samples/zufang-03.pdf",
  "questions": [
    {"q": "押金是多少钱？", "type": "直白", "expect": ["c36"]},
    {"q": "月租金是多少？", "type": "直白", "expect": ["c25"]},
    {"q": "可以养宠物吗？", "type": "直白", "expect": ["c46"]},
    {"q": "提前退租要付违约金吗？", "type": "直白", "expect": ["c64"]},
    {"q": "逾期交房租会怎样？", "type": "直白", "expect": ["c30"]},
    {"q": "退房时遗留的物品怎么处理？", "type": "直白", "expect": ["c74"]},
    {"q": "网络坏了怎么办？", "type": "直白", "expect": ["c34"]},
    {"q": "电费怎么收？", "type": "直白", "expect": ["c32"]},
    {"q": "我想养只猫，行不行？", "type": "换说法", "expect": ["c46"]},
    {"q": "朋友来找我玩，能在我这住几天吗？", "type": "换说法", "expect": ["c47"]},
    {"q": "墙上能挂画吗？", "type": "换说法", "expect": ["c42"]},
    {"q": "退房后钱多久能回到我卡上？", "type": "换说法", "expect": ["c39"]},
    {"q": "热水器坏了谁出钱修？", "type": "换说法", "expect": ["c54"]},
    {"q": "管家能不能随便进我屋？", "type": "换说法", "expect": ["c63"]},
    {"q": "我能自己换个锁吗？", "type": "换说法", "expect": ["c15"]},
    {"q": "合同到期了还想接着住，要怎么办？", "type": "换说法", "expect": ["c21"]},
    {"q": "房间里能煮火锅吗？", "type": "换说法", "expect": ["c44", "c43"]},
    {"q": "楼上漏水把我电脑泡了，谁赔？", "type": "换说法", "expect": ["c79"]},
    {"q": "要是公寓不开了，我怎么办？", "type": "换说法", "expect": ["c69"]},
    {"q": "电动车电瓶能拿回屋里充电吗？", "type": "换说法", "expect": ["c51"]},
    {"q": "住到一半想搬到隔壁大一点的房间，可以吗？", "type": "换说法", "expect": ["c24"]},
    {"q": "续租的话房租会涨吗？", "type": "换说法", "expect": ["c21"]},
    {"q": "有停车位吗？停车费多少？", "type": "没写", "expect": []},
    {"q": "公寓能帮我办居住证吗？", "type": "没写", "expect": []},
    {"q": "退租的时候要交中介费吗？", "type": "没写", "expect": []},
    {"q": "可以在阳台晾衣服吗？", "type": "没写", "expect": []}
  ]
